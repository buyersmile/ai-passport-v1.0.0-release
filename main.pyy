import requests
import time

def get_current_price(symbol):
    url = f"https://api.binance.com/api/v3/ticker/price?symbol={symbol}"
    return float(requests.get(url).json()['price'])

def trade_logic(symbol, profit_pct=0.02, loss_pct=0.01):
    entry_price = get_current_price(symbol)
    take_profit = entry_price * (1 + profit_pct)
    stop_loss = entry_price * (1 - loss_pct)
    
    print(f"[{time.strftime('%H:%M:%S')}] {symbol} | ปัจจุบัน: {entry_price:.2f} | TP: {take_profit:.2f} | SL: {stop_loss:.2f}")

try:
    while True:
        trade_logic("BTCUSDT")
        time.sleep(30)
except KeyboardInterrupt:
    print("\nหยุดการทำงานเรียบร้อย")

